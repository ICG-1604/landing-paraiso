---
import Section from '../components/Section.astro'
import Eyebrow from '../components/Eyebrow.astro'
import { faq } from '../data/landing'
---
<Section bg="paper" id="faq">
  <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
    <div class="lg:sticky lg:top-10 lg:self-start" data-reveal>
      <Eyebrow>{faq.eyebrow}</Eyebrow>
      <h2 class="t-h2 font-display font-semibold" style="color:var(--ink)">{faq.title}</h2>
    </div>

    <div data-reveal>
      {faq.preguntas.map((p) => (
        <details class="group border-b" style="border-color:var(--line)">
          <summary
            class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 font-body text-[1rem] font-semibold"
            style="color:var(--ink)"
          >
            {p.q}
            <span class="mt-0.5 shrink-0 transition-transform duration-200 group-open:rotate-45"
                  style="color:var(--azure)" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 16 16" fill="none">
                <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
              </svg>
            </span>
          </summary>
          <p class="font-body max-w-[68ch] pb-6 text-[0.96rem] leading-relaxed" style="color:rgba(12,26,46,.7)">
            {p.a}
          </p>
        </details>
      ))}
    </div>
  </div>
</Section>
