---
import { Image } from 'astro:assets'
import logo from '../assets/logo.png'
import { footer } from '../data/landing'
---
<footer class="w-full px-5 py-10 sm:px-8" style="background:var(--ink);color:var(--on-dark-faint)">
  <div class="mx-auto flex max-w-[1180px] flex-col gap-5 border-t pt-8 sm:flex-row sm:items-center sm:justify-between"
       style="border-color:rgba(255,255,255,.10)">
    <div class="flex items-center gap-4">
      <Image src={logo} alt="MUN en las aulas" width={120} height={90}
             class="h-7 w-auto" style="filter:brightness(0) invert(1);opacity:.55" loading="lazy" />
      <p class="font-body text-[0.82rem] leading-snug">{footer.linea}</p>
    </div>
    <nav class="flex gap-6 font-body text-[0.82rem]" aria-label="Enlaces legales">
      <!-- PENDIENTE: textos legales del formulario -->
      <a href="#" class="no-underline hover:opacity-75" style="color:inherit">{footer.legal}</a>
      <a href="#" class="no-underline hover:opacity-75" style="color:inherit">{footer.privacidad}</a>
    </nav>
  </div>
</footer>
