---
import Eyebrow from '../components/Eyebrow.astro'
import { Image } from 'astro:assets'
import foto from '../assets/alumnos/symun-2025-paraiso-9.jpg'
import { symun } from '../data/landing'
---
<section class="on-dark w-full px-5 py-16 sm:px-8 sm:py-24" style="background:var(--ink);color:var(--on-dark)">
  <div class="mx-auto grid max-w-[1180px] gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16">
    <div data-reveal>
      <Eyebrow onDark>{symun.eyebrow}</Eyebrow>
      <h2 class="t-h2 font-display font-semibold" style="color:#fff">{symun.title}</h2>
      <p class="t-lead font-body mt-5 max-w-[48ch]" style="color:var(--on-dark-muted)">{symun.lead}</p>

      <p class="mt-7 inline-flex items-center gap-2.5 rounded-full px-4 py-2 font-body text-[0.88rem] font-semibold"
         style="background:rgba(217,183,101,.14);color:var(--gold-bright)">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 1.8l1.8 3.9 4.2.5-3.1 2.9.85 4.2L8 11.3l-3.75 2 .85-4.2L2 6.2l4.2-.5z"
                stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
        </svg>
        {symun.award}
      </p>

      <p class="font-body mt-9 text-[0.85rem] uppercase" style="letter-spacing:.16em;color:var(--on-dark-faint)">
        {symun.temasIntro}
      </p>
      <ul class="mt-4 grid gap-x-8 gap-y-0 sm:grid-cols-2" role="list">
        {symun.temas.map((t) => (
          <li class="border-b py-3 font-body text-[0.94rem]"
              style="border-color:rgba(255,255,255,.10);color:var(--on-dark)">{t}</li>
        ))}
      </ul>
    </div>

    <figure class="overflow-hidden" style="border-radius:var(--radius-card-lg)" data-reveal>
      <Image src={foto} alt="Una alumna del Paraíso interviene ante su comité en SYMUN 2025"
             widths={[520, 820, 1200]} sizes="(min-width:1024px) 44vw, 92vw"
             class="aspect-[4/5] w-full object-cover" loading="lazy" />
    </figure>
  </div>
</section>
