---
import Eyebrow from '../components/Eyebrow.astro'
import { Image } from 'astro:assets'
import { equipo } from '../data/landing'

const retratos = import.meta.glob<{ default: ImageMetadata }>('../assets/equipo/*.jpg', { eager: true })
const foto = (f: string) => retratos[`../assets/equipo/${f}`].default
---
<section class="on-dark w-full px-5 py-16 sm:px-8 sm:py-24" style="background:var(--ink);color:var(--on-dark)">
  <div class="mx-auto max-w-[1180px]">
    <div class="max-w-[44ch]" data-reveal>
      <Eyebrow onDark>{equipo.eyebrow}</Eyebrow>
      <h2 class="t-h2 font-display font-semibold" style="color:#fff">{equipo.title}</h2>
      <p class="t-lead font-body mt-5" style="color:var(--on-dark-muted)">{equipo.lead}</p>
    </div>

    <ul class="mt-12 grid max-w-[820px] gap-6 sm:grid-cols-2" role="list">
      {equipo.personas.map((p, i) => (
        <li data-reveal style={`transition-delay:${i * 90}ms`}
            class="overflow-hidden" >
          <figure class="overflow-hidden" style="border-radius:var(--radius-card-lg)">
            {p.foto ? (
              <Image src={foto(p.foto)} alt={`Retrato de ${p.nombre}`}
                     widths={[300, 520, 760]} sizes="(min-width:640px) 40vw, 92vw"
                     class="aspect-[4/5] w-full object-cover" style="filter:saturate(.92)" loading="lazy" />
            ) : (
              <div class="flex aspect-[4/5] w-full items-center justify-center font-display text-[3.4rem] font-semibold"
                   style="background:var(--navy);color:var(--gold-soft)" aria-hidden="true">
                {p.nombre.split(' ').map((w) => w[0]).slice(0, 2).join('')}
              </div>
            )}
          </figure>
          <h3 class="font-display mt-5 text-[1.3rem] font-semibold" style="color:#fff">{p.nombre}</h3>
          <p class="font-body mt-1 text-[0.88rem] font-semibold" style="color:var(--gold-bright)">{p.rol}</p>
          <p class="font-body mt-3 text-[0.93rem] leading-relaxed" style="color:var(--on-dark-muted)">{p.bio}</p>
        </li>
      ))}
    </ul>

    <p class="font-display mt-14 max-w-[58ch] text-[1.15rem] italic leading-relaxed sm:text-[1.35rem]"
       style="color:var(--on-dark)" data-reveal>
      {equipo.cierre}
    </p>
  </div>
</section>
