---
import Section from '../components/Section.astro'
import { confianza } from '../data/landing'
---
<Section bg="cream" class="!py-12 sm:!py-16">
  <ul class="grid grid-cols-2 gap-x-6 gap-y-9 lg:grid-cols-4" role="list" data-reveal>
    {confianza.map((c) => (
      <li class="border-t pt-4" style="border-color:var(--line)">
        <p class="font-display text-3xl font-semibold leading-none sm:text-[2.6rem]"
           style="color:var(--navy)">{c.value}</p>
        <p class="font-body mt-2 text-[0.95rem] font-medium leading-snug" style="color:var(--ink)">
          {c.label}
        </p>
        <p class="font-body mt-1 text-[0.82rem] leading-snug" style="color:rgba(12,26,46,.58)">
          {c.sub}
        </p>
      </li>
    ))}
  </ul>
</Section>
