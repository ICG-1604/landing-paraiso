---
interface Props { onDark?: boolean; class?: string }
const { onDark = false, class: cls = '' } = Astro.props
---
<div class:list={['flex items-center gap-3 mb-4', cls]}>
  <span
    class="font-body text-[0.7rem] sm:text-xs font-semibold uppercase"
    style={`letter-spacing:.24em;color:${onDark ? 'var(--azure-soft)' : 'var(--azure)'}`}
  >
    <slot />
  </span>
  <span class="flex-1 h-px max-w-16" style="background:var(--gold);opacity:.7" aria-hidden="true"></span>
</div>
